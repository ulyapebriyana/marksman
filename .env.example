# --- Server ---
PORT=8787
HOST=127.0.0.1
SCAN_INTERVAL_SECONDS=60
ACTIVE_PRESET=marksman

# --- Stock market data (pick ONE provider) ---
# Used to fetch the real underlying equity price for tokenized-stock pools,
# so the server can compute premiumPct = on-chain price vs real price.
STOCK_API_PROVIDER=finnhub
# finnhub.io -> free key at https://finnhub.io/register
STOCK_API_KEY=

# --- Telegram alerts (optional) ---
# Leave blank to disable; POST /api/alert will still succeed but log a no-op.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Token report: social intelligence (optional, paid) ---
# Powers the team / catalysts / community / alpha sections of
# GET /api/token/:address. Leave blank and those sections say so explicitly
# rather than rendering empty — everything else in the report still works.
# SOCIAL_PROVIDER=twitterapi   # "twitterapi" (twitterapi.io) or "x" (official X API v2)
SOCIAL_PROVIDER=
SOCIAL_API_KEY=

# --- Token report: narrative synthesis (optional, paid) ---
# Turns the raw posts above into structured Indonesian sections. Without it
# the report still ships its deterministic Indonesian narrative (which is
# generated from the numbers, not paraphrased) plus the raw mentions.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# How long one token's report is cached, in seconds.
TOKEN_REPORT_TTL_SECONDS=300

# How long the GeckoTerminal half of a token report (holder distribution,
# deployer holding, launchpad state) is cached. Much longer than the report
# itself on purpose: those fields change about daily, and the background scan
# keeps GeckoTerminal's free rate limit saturated for roughly half of every
# minute — so not needing the call is what makes the section reliable.
GECKO_TOKEN_TTL_SECONDS=1800

# --- Wallet P&L calendar (GET /api/wallet/:address/pnl) ---
# Reconstructs daily realized P&L for a wallet providing liquidity on
# Uniswap v4 on Robinhood Chain. Needs no keys — Blockscout and GeckoTerminal
# are both public — but it does share GeckoTerminal's rate limit with the
# background scan, which is why the price cache below is worth keeping.
WALLET_PNL_TTL_SECONDS=300
WALLET_PNL_CONCURRENCY=6
WALLET_PNL_MAX_TX=600

# Where historical candles are persisted between restarts. A candle that has
# already closed never changes, so re-fetching it only spends quota.
# PRICE_CACHE_PATH=data/price-cache.json

# Optional: pre-fill the wallet field on the P&L screen.
DEFAULT_WALLET=
